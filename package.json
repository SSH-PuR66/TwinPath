{
    "name": "twinpath",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "audit:imports": "node scripts/audit-imports.mjs",
        "audit:css": "node scripts/audit-css-classes.mjs",
        "audit:control-plane": "node scripts/audit-control-plane.mjs",
        "audit": "npm run audit:imports && npm run audit:css && npm run audit:control-plane",
        "build": "npm run audit && vite build && node scripts/verify-dist.mjs",
        "preview": "vite preview",
        "test:worker": "node --test workers/control-plane/test/*.test.js",
        "test:gallery": "node --test test/galleryStorage.test.js",
        "worker:dev": "wrangler dev --config workers/control-plane/wrangler.jsonc",
        "worker:types": "wrangler types --config workers/control-plane/wrangler.jsonc workers/control-plane/src/worker-configuration.d.ts",
        "worker:deploy:check": "node scripts/validate-control-plane-deploy.mjs",
        "worker:dry-run": "npm run worker:deploy:check && wrangler deploy --dry-run --config workers/control-plane/wrangler.jsonc"
    },
    "dependencies": {
        "@react-three/drei": "^9.114.3",
        "@react-three/fiber": "^8.17.10",
        "@supabase/supabase-js": "^2.45.6",
        "framer-motion": "^12.42.2",
        "lucide-react": "^0.468.0",
        "react": "^18.3.1",
        "react-day-picker": "^9.14.0",
        "react-dom": "^18.3.1",
        "three": "^0.169.0"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "4.4.1",
        "vite": "^6.4.3",
        "wrangler": "^4.112.0"
    }
}
