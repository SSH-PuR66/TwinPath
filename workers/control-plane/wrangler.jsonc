{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "twinpath-control-plane",
  "main": "src/index.js",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "production",
    "PROVIDER_MODE": "production",
    "ALLOWED_ORIGINS": "https://twinpath.srodriguez46.workers.dev",
    "SUPABASE_URL": "https://wtdmjybpfimmsojsdobx.supabase.co",
    "HOUSEHOLD_MEMBERS_TABLE": "household_members",
    "PLAID_ENV": "production",
    "PLAID_COUNTRY_CODES": "US",
    "PLAID_ADDITIONAL_CONSENTED_PRODUCTS": "",
    "PLAID_RECURRING_ENABLED": "false",
    "AUTONOMOUS_PLAID_SYNC": "true",
    "PLAID_SYNC_STALE_MINUTES": "30",
    "PLAID_WEBHOOK_URL": "https://twinpath-control-plane.srodriguez46.workers.dev/v1/webhooks/plaid",
    "PLAID_REDIRECT_URI": "https://twinpath.srodriguez46.workers.dev/",
    "STRIPE_ALLOWED_PRICE_IDS": "price_1Twln5Q9XY1ln9nHsob1PaVN,price_1TwlnJQ9XY1ln9nHz11PrBLJ,price_1TwlnQQ9XY1ln9nHd0nvwFkJ",
    "STRIPE_CHECKOUT_SUCCESS_URL": "https://twinpath.srodriguez46.workers.dev/?billing=success",
    "STRIPE_CHECKOUT_CANCEL_URL": "https://twinpath.srodriguez46.workers.dev/?billing=cancelled",
    "STRIPE_PORTAL_RETURN_URL": "https://twinpath.srodriguez46.workers.dev/",
    "PLAID_ITEMS_TABLE": "plaid_items",
    "PLAID_ACCOUNTS_TABLE": "plaid_accounts",
    "PLAID_TRANSACTIONS_TABLE": "plaid_transactions",
    "PLAID_PRODUCT_SYNC_STATUS_TABLE": "plaid_product_sync_status",
    "PLAID_LIABILITIES_TABLE": "plaid_liabilities",
    "PLAID_RECURRING_STREAMS_TABLE": "plaid_recurring_streams",
    "STRIPE_CUSTOMERS_TABLE": "stripe_customers",
    "STRIPE_LIFECYCLE_EVENTS_TABLE": "stripe_lifecycle_events",
    "PROVIDER_WEBHOOK_EVENTS_TABLE": "provider_webhook_events",
    "REVENUE_EVENTS_TABLE": "revenue_events",
    "AGENT_AUDIT_EVENTS_TABLE": "agent_audit_events"
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "764201",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "AGENT_JOBS",
        "queue": "twinpath-agent-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "twinpath-agent-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "twinpath-agent-jobs-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
